{
  "schema_version": 1,
  "id": "oldweb-personal",
  "label": "Page personnelle — années 2000",
  "description": "Cadres nets, liens visibles, galerie et journal personnel ; le rendu rétro est fourni par un adaptateur dédié.",
  "keywords": [
    "rétro",
    "années 2000",
    "web personnel"
  ],
  "tokens": {
    "layout": {
      "content_width": "medium",
      "section_spacing": "compact",
      "hero": "minimal",
      "text_column": "narrow",
      "alignment": "left"
    },
    "typography": {
      "heading_style": "neutral",
      "body_style": "neutral",
      "scale": "restrained"
    },
    "media": {
      "prominence": "medium",
      "crop": "natural",
      "gallery": "grid",
      "full_bleed": false
    },
    "illustration": {
      "frequency": "occasional",
      "style": "line"
    },
    "surfaces": {
      "radius": "none",
      "borders": "present",
      "shadows": "none"
    },
    "accent": {
      "usage": "balanced",
      "backgrounds": "alternating"
    },
    "motion": {
      "level": "none"
    }
  },
  "constraints": {
    "contrast_target": "AA",
    "focus_visible": true,
    "reduced_motion": true,
    "autoplay_media": false
  }
}
